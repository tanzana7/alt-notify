[Unit]
Description=Alt Notify privacy deletion backup finalization
After=alt-notify.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/altnoti-backup --privacy-finalize
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/altnoti/backups /var/lib/altnoti-monitoring /run/lock
