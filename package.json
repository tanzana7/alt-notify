{
  "name": "discord-alt-notify-mvp",
  "version": "0.1.0-beta.12",
  "private": true,
  "description": "Discord公式Bot APIだけで複数アカウントのメンションを集約するMVP",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run && node tests/run-recovery.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "deploy:commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
